# =================================================================
# Klin — variáveis do SITE (Next.js, export estático no GitHub Pages)
# Copie para `.env.local` para rodar localmente. NUNCA versione o .env.local.
#
# Tudo aqui vai parar no JavaScript público do site. Por isso este arquivo
# só tem valores PÚBLICOS. Segredos (Gemini, Groq, VAPID privada...) ficam
# nos segredos das Edge Functions: veja supabase/functions/.env.example.
#
# No GitHub Actions estes valores vêm de Settings > Secrets and variables >
# Actions > aba "Variables" (não precisam ser "Secrets").
# =================================================================

# Painel do Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave "publishable" (ou "anon" legada). É pública por design:
# a proteção real dos dados vem das políticas de RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave PÚBLICA do Web Push (a privada fica só na Edge Function).
# Gerar o par com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Prefixo do site no GitHub Pages: "" com domínio próprio, "/<repo>" sem.
# No GitHub Actions é preenchido automaticamente; localmente deixe vazio.
NEXT_PUBLIC_BASE_PATH=
