# =================================================================
# Klin — modelo de variáveis de ambiente
# Copie para `.env.local` e preencha. NUNCA versione o .env.local.
#
# Regra de ouro: só variáveis com prefixo NEXT_PUBLIC_ chegam ao
# navegador. Chaves secretas JAMAIS podem ter esse prefixo.
# =================================================================

# --- App ---------------------------------------------------------
# URL pública do app (usada em links de notificação e e-mails do Auth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (público) ------------------------------------------
# Painel do Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave "publishable" (ou "anon" legada). É pública por design:
# a proteção real dos dados vem das políticas de RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Supabase (SECRETO — somente servidor) -----------------------
# Chave "secret" (ou "service_role" legada). Ignora o RLS.
# Usar apenas em Route Handlers/Server Actions que realmente precisam
# (ex.: disparo agendado de push). Nunca importar em código cliente.
SUPABASE_SECRET_KEY=

# --- IA primária: Google Gemini (SECRETO) -------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- IA de reserva: Groq (SECRETO) --------------------------------
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# Tempo-limite (ms) de cada chamada de IA antes de acionar a reserva
AI_TIMEOUT_MS=45000

# --- Web Push (VAPID) ---------------------------------------------
# Gerar com: npx web-push generate-vapid-keys
# A chave pública vai ao navegador; a privada fica só no servidor.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contato exigido pelo protocolo VAPID (mailto: ou https:)
VAPID_SUBJECT=mailto:contato@exemplo.com

# --- Agendamentos (SECRETO) ---------------------------------------
# Segredo que o agendador (cron) envia no header Authorization para
# chamar a rota de disparo de lembretes. Gere um valor longo e aleatório:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=
