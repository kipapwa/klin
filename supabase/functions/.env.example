# =================================================================
# Klin — SEGREDOS das Edge Functions (rodam nos servidores do Supabase)
#
# Produção: o workflow .github/workflows/deploy-functions.yml grava estes
# valores com `supabase secrets set`, lendo os Secrets do repositório.
# Local (`supabase functions serve --env-file supabase/functions/.env`):
# copie para supabase/functions/.env — que NUNCA é versionado.
#
# SUPABASE_URL e SUPABASE_ANON_KEY são fornecidas automaticamente pelo Supabase.
# =================================================================

# Origens que podem chamar as funções (CORS), separadas por vírgula.
# A origem do GitHub Pages é só o domínio, sem o caminho do repositório.
ALLOWED_ORIGINS=https://SEU-USUARIO.github.io,http://localhost:3000

# --- IA primária: Google Gemini -----------------------------------
GEMINI_API_KEY=
# gemini-2.5-flash foi descontinuado (desliga em 01/12/2026).
GEMINI_MODEL=gemini-3.8-flash

# --- IA de reserva: Groq (https://console.groq.com/keys) ----------
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# Tempo-limite (ms) de cada chamada de IA antes de passar para a reserva
AI_TIMEOUT_MS=45000
# Processamentos por IA permitidos por usuário a cada 24h
AI_DAILY_LIMIT=30

# --- Web Push (lembretes de dose) ---------------------------------
# Par gerado com: npx web-push generate-vapid-keys
# A pública é a mesma NEXT_PUBLIC_VAPID_PUBLIC_KEY do site.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@exemplo.com

# Segredo que o Supabase Cron envia em x-cron-secret para disparar-lembretes.
# O MESMO valor vai no Vault (ver supabase/cron.sql). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=
