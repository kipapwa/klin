{
  "name": "klin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/fix-segment-prefetch.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test \"supabase/functions/_shared/*.test.ts\" \"src/lib/*.test.ts\"",
    "test:db": "node --test \"supabase/tests/*.test.mjs\"",
    "check:functions": "npx --yes deno@2.9.6 check --config supabase/functions/deno.json supabase/functions/*/index.ts",
    "test:e2e": "node e2e/flow.mjs",
    "test:deno": "npx --yes deno@2.9.6 test --no-check --config supabase/functions/deno.json supabase/functions/_shared/"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "jspdf": "4.2.1",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "playwright": "1.56.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  },
  "allowScripts": {
    "core-js": false
  }
}
